# Auditd Rules Configuration for Thor
# Location: /etc/audit/rules.d/audit.rules
# After creating this file, reload rules: sudo augenrules --load
# View audit logs: sudo ausearch -ts recent

# ===== REMOVE ALL EXISTING RULES =====
-D

# ===== BUFFER SIZE =====
# Increase buffer size to prevent message loss
-b 8192

# ===== FAILURE MODE =====
# 0 = silent, 1 = printk, 2 = panic
-f 1

# ===== RATE LIMITING =====
# Set maximum audit message rate (messages per second)
-r 100

# ===== AUDIT SYSTEM CALLS =====
# Monitor for suspicious system calls

# Monitor execve (process execution)
-a always,exit -F arch=b64 -S execve -k exec
-a always,exit -F arch=b32 -S execve -k exec

# Monitor file deletions
-a always,exit -F arch=b64 -S unlink -S unlinkat -S rename -S renameat -k delete
-a always,exit -F arch=b32 -S unlink -S unlinkat -S rename -S renameat -k delete

# Monitor network connections
-a always,exit -F arch=b64 -S socket -S connect -k network
-a always,exit -F arch=b32 -S socket -S connect -k network

# ===== MONITOR USER AUTHENTICATION =====
# Monitor password file changes
-w /etc/passwd -p wa -k passwd_changes
-w /etc/shadow -p wa -k shadow_changes
-w /etc/group -p wa -k group_changes
-w /etc/gshadow -p wa -k gshadow_changes
-w /etc/security/opasswd -p wa -k opasswd_changes

# Monitor login records
-w /var/log/lastlog -p wa -k login_logout
-w /var/run/faillock/ -p wa -k login_failures
-w /var/log/tallylog -p wa -k login_failures

# ===== MONITOR SUDO AND SU =====
-w /etc/sudoers -p wa -k sudoers_changes
-w /etc/sudoers.d/ -p wa -k sudoers_changes
-w /usr/bin/sudo -p x -k sudo_execution
-w /usr/bin/su -p x -k su_execution

# ===== MONITOR SSH CONFIGURATION =====
-w /etc/ssh/sshd_config -p wa -k sshd_config_changes
-w /etc/ssh/sshd_config.d/ -p wa -k sshd_config_changes
-w /root/.ssh/ -p wa -k root_ssh_changes
-w /home/*/.ssh/ -p wa -k user_ssh_changes

# ===== MONITOR PAM CONFIGURATION =====
-w /etc/pam.d/ -p wa -k pam_changes
-w /etc/security/ -p wa -k security_changes

# ===== MONITOR SYSTEM CONFIGURATION =====
# Monitor cron jobs
-w /etc/crontab -p wa -k cron_changes
-w /etc/cron.d/ -p wa -k cron_changes
-w /etc/cron.daily/ -p wa -k cron_changes
-w /etc/cron.hourly/ -p wa -k cron_changes
-w /etc/cron.monthly/ -p wa -k cron_changes
-w /etc/cron.weekly/ -p wa -k cron_changes
-w /var/spool/cron/ -p wa -k cron_changes

# Monitor systemd services
-w /etc/systemd/ -p wa -k systemd_changes
-w /lib/systemd/ -p wa -k systemd_changes

# Monitor kernel modules
-w /sbin/insmod -p x -k kernel_modules
-w /sbin/rmmod -p x -k kernel_modules
-w /sbin/modprobe -p x -k kernel_modules
-a always,exit -F arch=b64 -S init_module -S delete_module -k kernel_modules
-a always,exit -F arch=b32 -S init_module -S delete_module -k kernel_modules

# ===== MONITOR NETWORK CONFIGURATION =====
-w /etc/hosts -p wa -k network_config_changes
-w /etc/hostname -p wa -k network_config_changes
-w /etc/network/ -p wa -k network_config_changes
-w /etc/netplan/ -p wa -k network_config_changes
-w /etc/resolv.conf -p wa -k network_config_changes

# Monitor firewall changes
-w /etc/ufw/ -p wa -k firewall_changes
-w /etc/iptables/ -p wa -k firewall_changes
-w /usr/sbin/iptables -p x -k firewall_commands
-w /usr/sbin/ip6tables -p x -k firewall_commands
-w /usr/sbin/ufw -p x -k firewall_commands

# ===== MONITOR APPLICATION LOGS =====
-w /var/log/auth.log -p wa -k auth_log_changes
-w /var/log/syslog -p wa -k syslog_changes
-w /var/log/kern.log -p wa -k kern_log_changes
-w /var/log/fail2ban.log -p wa -k fail2ban_changes

# ===== MONITOR WEB SERVER CONFIGURATION =====
-w /etc/nginx/ -p wa -k nginx_config_changes
-w /etc/apache2/ -p wa -k apache_config_changes
-w /var/www/ -p wa -k webroot_changes

# ===== MONITOR DATABASE CONFIGURATION =====
-w /etc/mysql/ -p wa -k mysql_config_changes
-w /etc/postgresql/ -p wa -k postgres_config_changes

# ===== MONITOR PRIVILEGE ESCALATION =====
# Monitor use of privileged commands
-a always,exit -F path=/usr/bin/passwd -F perm=x -F auid>=1000 -F auid!=4294967295 -k privileged_passwd
-a always,exit -F path=/usr/bin/chsh -F perm=x -F auid>=1000 -F auid!=4294967295 -k privileged_chsh
-a always,exit -F path=/usr/bin/chfn -F perm=x -F auid>=1000 -F auid!=4294967295 -k privileged_chfn
-a always,exit -F path=/usr/bin/wall -F perm=x -F auid>=1000 -F auid!=4294967295 -k privileged_wall
-a always,exit -F path=/usr/bin/chage -F perm=x -F auid>=1000 -F auid!=4294967295 -k privileged_chage
-a always,exit -F path=/usr/bin/gpasswd -F perm=x -F auid>=1000 -F auid!=4294967295 -k privileged_gpasswd
-a always,exit -F path=/usr/bin/newgrp -F perm=x -F auid>=1000 -F auid!=4294967295 -k privileged_newgrp

# Monitor setuid/setgid programs
-a always,exit -F arch=b64 -S setuid -S setgid -S setreuid -S setregid -k setuid
-a always,exit -F arch=b32 -S setuid -S setgid -S setreuid -S setregid -k setuid

# ===== MONITOR FILE SYSTEM MOUNTS =====
-a always,exit -F arch=b64 -S mount -S umount2 -k mounts
-a always,exit -F arch=b32 -S mount -S umount2 -k mounts

# ===== MONITOR TIME CHANGES =====
-a always,exit -F arch=b64 -S adjtimex -S settimeofday -k time_changes
-a always,exit -F arch=b32 -S adjtimex -S settimeofday -S stime -k time_changes
-a always,exit -F arch=b64 -S clock_settime -k time_changes
-a always,exit -F arch=b32 -S clock_settime -k time_changes
-w /etc/localtime -p wa -k time_changes

# ===== MONITOR BOOT LOADER =====
-w /boot/grub/grub.cfg -p wa -k grub_changes
-w /boot/grub2/grub.cfg -p wa -k grub_changes

# ===== SUSPICIOUS ACTIVITIES =====
# Monitor suspicious file operations
-a always,exit -F arch=b64 -S chmod -F auid>=1000 -F auid!=4294967295 -k perm_mod
-a always,exit -F arch=b64 -S chown -F auid>=1000 -F auid!=4294967295 -k perm_mod
-a always,exit -F arch=b32 -S chmod -F auid>=1000 -F auid!=4294967295 -k perm_mod
-a always,exit -F arch=b32 -S chown -F auid>=1000 -F auid!=4294967295 -k perm_mod

# Monitor access to sensitive directories
-w /tmp/ -p wa -k tmp_changes
-w /var/tmp/ -p wa -k tmp_changes
-w /dev/shm/ -p wa -k shm_changes

# ===== MAKE CONFIGURATION IMMUTABLE =====
# This prevents the audit configuration from being changed
# Comment out during testing, uncomment for production
# -e 2

# ===== END OF CONFIGURATION =====

