[EMAIL]
sender_email = your-email@example.com
recipient_email = recipient@example.com

[WEB]
hostname = your-hostname
report_url = http://your-web-server/Hacker_Report.html

[MAP]
# Base map tiles for the report map.
# Common options: OpenStreetMap, CartoDB positron, CartoDB dark_matter, Stamen Terrain
# CartoDB tiles now require an API key (unauthenticated requests show "API KEY REQUIRED").
tiles = OpenStreetMap
# Enable/disable map features
enable_security_event_markers = True
enable_nginx_markers = True
enable_legend = False
# Geolocation method: 'api' (ip-api.com - more accurate, always up-to-date) 
#                  or 'database' (GeoLite2 - local, may be outdated)
# API method uses caching to minimize requests (45 requests/minute limit)
geolocation_method = database
# MaxMind credentials (required for automatic GeoLite2 database download)
# Get a free account at: https://www.maxmind.com/en/geolite2/signup
# Find your Account ID and License Key in your MaxMind account portal
# maxmind_account_id = YOUR_ACCOUNT_ID_HERE
# maxmind_license_key = YOUR_LICENSE_KEY_HERE

[TRUSTED]
# Comma-separated IPs or CIDRs. Successful SSH from these is informational.
# Private LAN, loopback and Tailscale are always trusted.
# trusted_ips = 203.0.113.10, 198.51.100.0/24

[ARCHIVE]
archive_dir = /var/www/html/reports
archive_top_n = 50
archive_max_days = 730
archive_events = True
archive_max_events = 20000
